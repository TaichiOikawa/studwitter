{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "studwitter",
	"compatibility_date": "2026-09-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"BETTER_AUTH_URL",
			"GOOGLE_CLIENT_ID",
			"GOOGLE_CLIENT_SECRET",
			"ADMIN_EMAIL"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "studwitter",
			"database_id": "7c471a3e-2e7a-4cfe-9566-59fe283ae4f0",
			"migrations_dir": "prisma/migrations"
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
}
