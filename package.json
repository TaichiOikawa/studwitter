{
  "name": "studwitter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "yarn db:generate && vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --env-file .env --persist-to .wrangler/state",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "yarn db:migrate:local",
    "db:migrate:local": "yarn wrangler d1 migrations apply studwitter --local",
    "db:migrate:remote": "yarn wrangler d1 migrations apply studwitter --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/prisma-adapter": "^1.7.6",
    "@prisma/adapter-d1": "7",
    "@prisma/client": "7",
    "@vinext/cloudflare": "^1.0.0-beta.11",
    "better-auth": "^1.7.6",
    "cn": "^0.4.0",
    "dotenv": "^18.0.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.3.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.0.0-beta.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  },
  "packageManager": "yarn@4.13.0",
  "type": "module"
}
